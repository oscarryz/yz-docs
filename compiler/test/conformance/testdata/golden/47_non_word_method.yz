// Non-word method name: ++ defined on a struct, called infix as a ++ b.
Greeter: {
    name String
    ++ #(other String, String) { "${name} and ${other}" }
}

// Chains are left-associative: a ++ b ++ c is (a ++ b) ++ c, i.e. a.++(b).++(c).
// The label records the grouping, so right-association would print (a (b c)).
Tag: {
    label String
    ++ #(other Tag, Tag) { Tag("(${label} ${other.label})") }
}

main: {
    a: Greeter("Alice")
    c: a ++ "Bob"
    print(c)

    x: Tag("a")
    y: Tag("b")
    z: Tag("c")
    left: x ++ y ++ z
    print(left.label)
    yz: y ++ z
    right: x ++ yz
    print(right.label)
}
